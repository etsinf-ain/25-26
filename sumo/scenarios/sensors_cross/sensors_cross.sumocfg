<?xml version="1.0" encoding="UTF-8"?>
<configuration xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://sumo.dlr.de/xsd/sumoConfiguration.xsd">
    <input>
        <net-file value="sensors_cross.net.xml"/>
        <route-files value="sensors_cross.rou.xml"/>
        <additional-files value="sensors_cross.add.xml"/>
    </input>
    <gui_only>
        <gui-settings-file value="viewsettings.xml"/>
        <start value="true"/>
    </gui_only>
    <time>
        <begin value="0"/>
        <end value="3600"/>
    </time>
</configuration>
